<Window x:Class="CreateBatchFilesForXbox360XBLAGames.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About - Batch File Creator for Xbox 360 XBLA Games"
        Width="600"
        Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Center">
                <Image Width="110" Height="110"
                       Source="pack://application:,,,/images/logo.png"
                       ToolTip="Batch File Creator for Xbox 360 XBLA Games logo"/>
            </StackPanel>
        </Border>

        <!-- Title & Version -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource AboutTitleStyle}"
                           Text="Batch File Creator for Xbox 360 XBLA Games"/>
                <TextBlock x:Name="AppVersionTextBlock"
                           Margin="0,10,0,0"
                           Text=""
                           Style="{StaticResource AboutSubtitleStyle}"/>
            </StackPanel>
        </Border>

        <!-- Description -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Style="{StaticResource AboutSectionHeaderStyle}" Text="Description"/>
                <TextBlock Style="{StaticResource AboutBodyTextStyle}"
                           Text="A simple utility to create batch files for launching your Xbox 360 XBLA games with the Xenia emulator."/>
                <TextBlock Style="{StaticResource AboutSectionHeaderStyle}" Text="Links" Margin="0,16,0,8"/>
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink NavigateUri="https://www.purelogiccode.com"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource LinkBrush}"
                               TextDecorations="None">
                        purelogiccode.com
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink NavigateUri="https://github.com/drpetersonfernandes/CreateBatchFilesForXbox360XBLAGames"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource LinkBrush}"
                               TextDecorations="None">
                        View on GitHub
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Click="CheckForUpdatesButton_Click"
                    Content="Check for Updates"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,10,0"
                    ToolTip="Check if a newer version is available"/>
            <Button Click="CloseButton_Click"
                    Content="Close"
                    Style="{StaticResource MutedButtonStyle}"
                    ToolTip="Close this window"/>
        </StackPanel>
    </Grid>
</Window>
